# -------------------------------------------------------
# Secrets — never commit these
# -------------------------------------------------------
.env
.env.*
!.env.example

# -------------------------------------------------------
# OS
# -------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------------------------------------
# IDE
# -------------------------------------------------------
.vscode/settings.json
.idea/
*.swp
*.swo

# -------------------------------------------------------
# The template's own test tooling — not a stack choice. The scripts under
# .claude/skills/ ship with Python and bash tests that CI runs, and those
# leave artifacts behind wherever they run, including in a project that
# never picks Python as its stack.
# -------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# -------------------------------------------------------
# Stack-specific ignores (Python .venv, node_modules/dist, *.db, etc.)
# — /init-project appends the right block(s) once the stack is chosen.
# Project-specific entries go below that.
# -------------------------------------------------------
